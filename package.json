{
  "name": "rag-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade RAG system with multi-format ingestion, semantic search, and LLM orchestration",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "api:dev": "pnpm --filter @rag/api dev",
    "web:dev": "pnpm --filter @rag/web dev",
    "docker:build": "./scripts/docker-build.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "k8s:deploy": "./scripts/deploy.sh",
    "db:migrate": "pnpm --filter @rag/api migration:run",
    "db:seed": "./scripts/seed-db.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
